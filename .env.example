# Lumina Frontend environment variables
# Copy this file to .env.local and adjust values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Never place secrets behind the NEXT_PUBLIC_ prefix.

# Base URL of the Lumina backend API.
# Type: HTTP(S) URL without embedded credentials (required)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend path for the SEP-10 Stellar Web Auth endpoint (GET challenge, POST token).
# Appended to NEXT_PUBLIC_API_URL. Defaults to /auth/sep10 when unset.
# Type: canonical slash-prefixed path, no query/fragment/traversal (optional; default /auth/sep10)
NEXT_PUBLIC_SEP10_AUTH_PATH=/auth/sep10

# Soroban RPC endpoint for contract reads and transaction submission.
# Type: HTTP(S) URL without embedded credentials (required)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Active Stellar network.
# Type: enum[testnet|futurenet|mainnet] (required)
NEXT_PUBLIC_SOROBAN_NETWORK=testnet

# Sentry DSN for client-side error reporting. Leave empty to disable.
# Type: HTTP(S) Sentry DSN with public project key (optional; empty disables)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry org and project for source map uploads (required for production builds).
# Type: string (optional)
SENTRY_ORG=
# Type: string (optional)
SENTRY_PROJECT=

# WalletConnect project ID for wallet sessions. Leave empty to disable.
# Type: string (optional; empty disables)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
